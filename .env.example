# Anthropic — required for scoring and tailoring
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# JSearch via RapidAPI — optional job source
# Subscribe at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Adzuna — optional job source
# Register at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Server port (web dev server proxies /api here)
PORT=3001
